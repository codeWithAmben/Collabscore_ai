# Server & CORS
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Laragon Local MySQL (empty password by default)
DATABASE_URL=mysql://root:@127.0.0.1:3306/collabscore_ai
# Set to false in strict production MySQL deployments to fail fast if DB is unreachable
ALLOW_MEMORY_FALLBACK=true

# Auth & Token Encryption
JWT_SECRET=replace-with-a-long-random-jwt-secret
TOKEN_ENCRYPTION_KEY=replace-with-32-character-aes-key

# Google OAuth 2.0 (Google Cloud Console Web Client)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google AI Studio (Gemini 3.8 Flash)
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
