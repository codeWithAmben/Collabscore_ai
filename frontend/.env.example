# Backend API Origin (leave blank in local Vite dev to use vite.config.js /api proxy)
VITE_API_URL=http://localhost:5000

# Optional: Google Picker API browser credentials for live Drive file selection
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-browser-api-key
VITE_GOOGLE_APP_ID=your-numeric-google-cloud-project-number
